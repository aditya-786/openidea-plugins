{
  "properties": {
    "watchDdev": {
      "type": "boolean",
      "title": "Refresh DDEV status every minute",
      "default": true
    },
    "checkForUpdates": {
      "type": "boolean",
      "title": "Check for DDEV updates automatically",
      "default": true
    },
    "autoConfigureDataSource": {
      "title": "Keep a Database connection for the DDEV database",
      "type": "boolean",
      "default": true
    },
    "phpVersion": {
      "type": "string",
      "title": "PHP version for Configure Project (optional)",
      "default": ""
    },
    "autoConfigureRunTarget": {
      "type": "boolean",
      "title": "Offer DDEV for PHP, Node.js, Composer and project runs",
      "default": true
    },
    "containerRoot": {
      "type": "string",
      "title": "Project path inside the web container",
      "default": "/var/www/html"
    }
  }
}
